<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net6.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Bson.MvtNet</PackageId>
    <Version>1.1.0</Version>
    <Authors>bson</Authors>
    <Description>Encode Mapbox Vector Tiles (MVT 2.1) from plain C#: WGS84 points, lines, polygons or GeoJSON in, protobuf tiles out. Projection, clipping and tag interning are handled for you. No GIS stack required.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/bjornhandersson/com.bson/blob/master/dotnet/MvtNet/README.md#release-notes</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>mvt;mapbox;vector-tiles;gis;maps</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/bjornhandersson/com.bson</RepositoryUrl>
    <PackageProjectUrl>https://github.com/bjornhandersson/com.bson</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CI)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <!--
    netstandard2.0 keeps the library usable from .NET Framework and Unity.
    Modern consumers resolve the net6.0 build, so they are unaffected.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="4.7.2" />
    <PackageReference Include="System.Memory" Version="4.5.4" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.13.0" />
    <PackageReference
      Include="Grpc.Tools"
      Version="2.83.0"
      PrivateAssets="all"
      Condition="'$(SKIP_PROTOC)' != 'true'"
    />
  </ItemGroup>
  <ItemGroup Condition="'$(SKIP_PROTOC)' != 'true'">
    <Protobuf Include="Proto/vector_tile.proto" CompileOutputs="true" GrpcServices="None" Access="Internal" />
    <Compile Remove="Generated/**" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MvtNet.Tests" />
  </ItemGroup>
</Project>
