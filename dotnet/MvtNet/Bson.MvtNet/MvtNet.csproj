<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Bson.MvtNet</PackageId>
    <Version>1.0.4</Version>
    <Authors>bson</Authors>
    <Description>Encode WGS84 geographic features into Mapbox Vector Tiles (MVT spec v2.1)</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>mvt;mapbox;vector-tiles;gis;maps</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/bjornhandersson/com.bson</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CI)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.13.0" />
    <PackageReference
      Include="Grpc.Tools"
      Version="2.83.0"
      PrivateAssets="all"
      Condition="'$(SKIP_PROTOC)' != 'true'"
    />
  </ItemGroup>
  <ItemGroup Condition="'$(SKIP_PROTOC)' != 'true'">
    <Protobuf Include="Proto/vector_tile.proto" CompileOutputs="true" GrpcServices="None" Access="Internal" />
    <Compile Remove="Generated/**" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MvtNet.Tests" />
  </ItemGroup>
</Project>
